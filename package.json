{
  "name": "goralert",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-firebase-sw.mjs && next dev",
    "build": "node scripts/generate-firebase-sw.mjs && next build",
    "generate:sw": "node scripts/generate-firebase-sw.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:firestore-payload": "node --test tests/firestore-payload.test.mjs",
    "test:push-devices": "node --test tests/push-device-data.test.mjs",
    "test:calendar-contract": "node --test tests/calendar-contract.test.mjs",
    "test:calendar-view": "node --test tests/calendar-view.test.mjs",
    "test:calendar-display": "node --test tests/calendar-display.test.mjs",
    "test:calendar-alerts": "node --test tests/calendar-alerts.test.mjs",
    "test:alert-contract": "node --test tests/alert-rule-contract.test.mjs",
    "test:firestore-emulator": "firebase emulators:exec --only auth,firestore --project demo-goralert \"node scripts/run-firestore-emulator-tests.mjs\""
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "0.408.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
