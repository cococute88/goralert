rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validAlertSettings(data) {
      return data.keys().hasOnly([
          'globalEnabled',
          'telegramChatId',
          'pushTokens',
          'pushDevices',
          'defaultQuietHours',
          'defaultAlertTime',
          'defaultMessageTitle',
          'defaultMessageBody',
          'updatedAt'
        ])
        && (!('globalEnabled' in data) || data.globalEnabled is bool)
        && (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 128))
        && (!('pushTokens' in data) || (data.pushTokens is list && data.pushTokens.size() <= 100))
        // Rules cannot iterate over maps in an array. The client normalizes each
        // device object; Rules still enforce the container type and product cap.
        && (!('pushDevices' in data) || (data.pushDevices is list && data.pushDevices.size() <= 100))
        && (!('defaultQuietHours' in data) || data.defaultQuietHours is map)
        && (!('defaultAlertTime' in data) || (data.defaultAlertTime is string && data.defaultAlertTime.size() <= 16))
        && (!('defaultMessageTitle' in data) || (data.defaultMessageTitle is string && data.defaultMessageTitle.size() <= 200))
        && (!('defaultMessageBody' in data) || (data.defaultMessageBody is string && data.defaultMessageBody.size() <= 2000))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function schedulerFields() {
      return [
        'nextScheduledAt',
        'lastProcessedScheduledAt',
        'lastOccurrenceId',
        'scheduleStatus',
        'scheduleChangedAt',
        'lastTriggeredAt',
        'lastValue',
        'engineVersion'
      ];
    }

    function validNewAlertRule(userId) {
      return request.resource.data.uid == userId
        && !request.resource.data.keys().hasAny(schedulerFields());
    }

    function validAlertRuleOwner(userId) {
      return request.resource.data.uid == userId
        && (!('uid' in resource.data) || resource.data.uid == userId);
    }

    function validOrdinaryAlertRuleUpdate(userId) {
      return validAlertRuleOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(schedulerFields());
    }

    function validScheduleEdit(userId) {
      return validAlertRuleOwner(userId)
        && (!('scheduleStatus' in resource.data) || resource.data.scheduleStatus != 'processing')
        && !('nextScheduledAt' in request.resource.data)
        && request.resource.data.scheduleStatus == 'schedule_changed'
        && request.resource.data.scheduleChangedAt == request.time
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'lastProcessedScheduledAt',
          'lastOccurrenceId',
          'lastTriggeredAt',
          'lastValue',
          'engineVersion'
        ]);
    }

    function validClientTestLog(logId) {
      return request.resource.data.isTest == true
        && request.resource.data.id == logId
        && request.resource.data.eventId == logId;
    }

    function validScheduleCancellation(userId, logId) {
      return request.resource.data.isTest == false
        && request.resource.data.id == logId
        && request.resource.data.eventId == logId
        && request.resource.data.ruleId is string
        && request.resource.data.status == 'cancelled'
        && request.resource.data.failureCode == 'schedule_changed'
        && getAfter(/databases/$(database)/documents/users/$(userId)/alertRules/$(request.resource.data.ruleId)).data.scheduleStatus == 'schedule_changed'
        && getAfter(/databases/$(database)/documents/users/$(userId)/alertRules/$(request.resource.data.ruleId)).data.scheduleChangedAt == request.time;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /alertSettings/{settingsId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validAlertSettings(request.resource.data);
      }

      match /alertRules/{ruleId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validNewAlertRule(userId);
        allow update: if isOwner(userId) && (
          validOrdinaryAlertRuleUpdate(userId) || validScheduleEdit(userId)
        );
      }

      // Production occurrences and scheduler state are Admin SDK-owned. The
      // browser may only create/update its own explicit test log or create the
      // schedule-cancellation record in the same transaction as a schedule edit.
      match /notificationLogs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && (
          validClientTestLog(logId) || validScheduleCancellation(userId, logId)
        );
        allow update: if isOwner(userId)
          && resource.data.isTest == true
          && validClientTestLog(logId);
        allow delete: if false;
      }

      // Keep the existing owner-only policy for all other user subcollections.
      // Excluding alertSettings here ensures the validation above cannot be
      // bypassed through an overlapping recursive allow rule.
      match /{collectionId}/{document=**} {
        allow read, write: if ![
          'alertSettings', 'alertRules', 'notificationLogs'
        ].hasAny([collectionId]) && isOwner(userId);
      }
    }
  }
}
